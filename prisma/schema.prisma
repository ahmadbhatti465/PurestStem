generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  password  String
  role      String     @default("user")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  reviews   Review[]
  cartItems CartItem[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  createdAt   DateTime   @default(now())
  products    Product[]
  blogPosts   BlogPost[]
}

model Product {
  id                    String      @id @default(cuid())
  name                  String
  slug                  String      @unique
  description           String?
  shortDescription      String?
  brand                 String?     @default("PurestStem")
  productType           String?
  condition             String?     @default("New") // New, Used, Refurbished
  gtin                  String?
  mpn                   String?
  unit                  String?     @default("piece")
  price                 Float
  salePrice             Float?
  stock                 Int         @default(0)
  sku                   String?     @unique
  weight                String?
  weightValue           Float?
  weightUnit            String?     @default("ml")
  ingredients           String?
  structuredIngredients String?     // JSON array of { name: string, description?: string }
  howToUse              String?
  structuredHowToUse    String?     // JSON array of { step: number, instruction: string }
  benefits              String?     // JSON array of strings
  features              String?     // JSON array of strings
  image                 String?
  images                String?
  imageMetadata         String?     // JSON array of { url, alt, title, caption, width, height, isDecorative, sortOrder, size }
  featured              Boolean     @default(false)
  isActive              Boolean     @default(true)
  status                String      @default("published") // published, draft, scheduled
  publishedAt           DateTime?
  scheduledAt           DateTime?
  seoTitle              String?
  seoDescription        String?
  focusKeyword          String?
  secondaryKeywords     String?     // Comma-separated string or JSON
  canonicalUrl          String?
  robotsIndex           Boolean     @default(true)
  robotsFollow          Boolean     @default(true)
  ogTitle               String?
  ogDescription         String?
  ogImage               String?
  twitterTitle          String?
  twitterDescription    String?
  twitterImage          String?
  faqs                  String?     // JSON array of { question: string, answer: string }
  relatedProductIds     String?     // JSON array of product IDs
  relatedBlogIds        String?     // JSON array of blog post IDs
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  orderItems            OrderItem[]
  reviews               Review[]
  cartItems             CartItem[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  status        String      @default("pending")
  total         Float
  shippingCost  Float       @default(190)
  name          String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String?
  notes         String?
  paymentMethod String      @default("cod")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity  Int
  price     Float
}

model BlogPost {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  excerpt           String?
  content           String
  image             String?
  imageAlt          String?
  imageCaption      String?
  imageCredit       String?
  imageWidth        Int?
  imageHeight       Int?
  author            String    @default("PurestStem")
  authorBio         String?
  authorImage       String?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags              String?   // JSON array or comma-separated string
  status            String    @default("published") // draft, scheduled, published
  published         Boolean   @default(true)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  seoTitle          String?
  seoDescription    String?
  focusKeyword      String?
  secondaryKeywords String?   // JSON array or comma-separated string
  canonicalUrl      String?
  robotsIndex       Boolean   @default(true)
  robotsFollow      Boolean   @default(true)
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  twitterTitle      String?
  twitterDescription String?
  twitterImage      String?
  faqs              String?   // JSON array of FaqItem
  relatedProductIds String?   // JSON array of product IDs
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  sourcePath  String   @unique
  targetPath  String
  statusCode  Int      @default(301)
  createdAt   DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  rating    Int
  comment   String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
